# 复制为 .env 后填入真实值。.env 不要提交到 Git。

# 认证（必填，缺失时应用启动即报错）
AUTH_SECRET=
# 可选，登录令牌有效期（小时），默认 168
AUTH_TOKEN_TTL_HOURS=168

# 模型（通义千问，DashScope OpenAI 兼容接口）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 网络搜索
TAVILY_API_KEY=

# 对象存储（图片上传）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 可选，默认 oss-cn-beijing.aliyuncs.com
OSS_ENDPOINT=

# LangSmith 追踪（可选）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=

# 遗留项，当前代码未使用
DEEPSEEK_API_KEY=
